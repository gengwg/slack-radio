[Unit]
Description=Serve the Slack Radio feed on Tailscale
After=network-online.target

[Service]
WorkingDirectory=%h/projects/slack-radio
ExecStart=%h/.local/bin/uv run python -m http.server 8000 --bind <tailscale-ip> -d out
# Tailscale may not have its address yet at boot.
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
